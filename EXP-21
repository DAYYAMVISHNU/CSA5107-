#include <stdio.h>
#include <string.h>

int main() {
    char data[100];
    int i, n, block=8, pad;

    printf("Enter binary data (0 and 1 only): ");
    scanf("%99s",data);

    n=strlen(data);
    pad=block-(n%block);

    printf("Padded data: %s",data);
    printf("1");

    for(i=1;i<pad;i++)
        printf("0");

    printf("\n");
    return 0;
}
