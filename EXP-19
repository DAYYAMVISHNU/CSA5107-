#include <stdio.h>

int main() {
    int p[4], c[4], iv, key, i;

    printf("Enter 4 plaintext block values (0-255):\n");
    for(i=0;i<4;i++)
        scanf("%d",&p[i]);

    printf("Enter IV and key values (0-255): ");
    scanf("%d%d",&iv,&key);

    for(i=0;i<4;i++) {
        int previous = (i==0) ? iv : c[i-1];
        c[i] = (p[i] ^ previous) ^ key;
    }

    printf("Educational CBC-like output:\n");
    for(i=0;i<4;i++)
        printf("%d ",c[i]);

    printf("\n");
    return 0;
}
