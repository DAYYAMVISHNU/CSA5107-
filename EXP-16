
#include <stdio.h>
#include <ctype.h>

int main() {
    char s[1000];
    int f[26]={0},i;

    printf("Enter ciphertext: ");
    fgets(s,sizeof(s),stdin);

    for(i=0;s[i];i++)
        if(isalpha((unsigned char)s[i]))
            f[toupper((unsigned char)s[i])-'A']++;

    printf("Letter frequencies:\n");
    for(i=0;i<26;i++)
        printf("%c = %d\n",'A'+i,f[i]);

    return 0;
}
