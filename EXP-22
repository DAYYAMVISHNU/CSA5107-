#include <stdio.h>

int main() {
    int p[4], c[4], d[4];
    int iv, key, i, prev;

    printf("Enter 4 plaintext values (0-255): ");
    for(i=0;i<4;i++) scanf("%d",&p[i]);

    printf("Enter IV and key (0-255): ");
    scanf("%d%d",&iv,&key);

    prev=iv;
    for(i=0;i<4;i++) {
        c[i]=p[i]^prev^key;
        prev=c[i];
    }

    printf("Ciphertext: ");
    for(i=0;i<4;i++) printf("%d ",c[i]);

    prev=iv;
    for(i=0;i<4;i++) {
        d[i]=c[i]^prev^key;
        prev=c[i];
    }

    printf("\nDecrypted: ");
    for(i=0;i<4;i++) printf("%d ",d[i]);

    printf("\n");
    return 0;
}
