
#include <stdio.h>

int main() {
    char s[500];
    int i,k;

    printf("Enter ciphertext: ");
    fgets(s,sizeof(s),stdin);

    for(k=0;k<26;k++) {
        printf("\nShift %d: ",k);
        for(i=0;s[i];i++) {
            if(s[i]>='A' && s[i]<='Z')
                putchar((s[i]-'A'-k+26)%26+'A');
            else if(s[i]>='a' && s[i]<='z')
                putchar((s[i]-'a'-k+26)%26+'a');
            else putchar(s[i]);
        }
    }

    return 0;
}
