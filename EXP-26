#include <stdio.h>

int gcd(int a,int b) {
    while(b) {
        int t=b;
        b=a%b;
        a=t;
    }
    return a;
}

int main() {
    int m,n,g;

    printf("Enter modulus n: ");
    scanf("%d",&n);
    printf("Enter plaintext block m: ");
    scanf("%d",&m);

    g=gcd(m,n);
    printf("GCD = %d\n",g);

    if(g>1 && g<n)
        printf("A nontrivial factor of n is revealed.\n");
    else
        printf("No nontrivial factor revealed.\n");

    return 0;
}
