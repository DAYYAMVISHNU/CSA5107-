
#include <stdio.h>

int main() {
    char s[1000];
    int f[128] = {0}, i;

    printf("Enter ciphertext:\n");
    fgets(s, sizeof(s), stdin);

    for (i = 0; s[i]; i++)
        if ((unsigned char)s[i] < 128)
            f[(unsigned char)s[i]]++;

    printf("\nCharacter frequencies:\n");
    for (i = 0; i < 128; i++)
        if (f[i] > 0)
            printf("%c : %d\n", i, f[i]);

    return 0;
}
