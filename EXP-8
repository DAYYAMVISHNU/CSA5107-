
#include <stdio.h>
#include <ctype.h>

int main() {
    char s[200];
    char key[] = "CIPHERABDFGJKLMNOQSTUVWXYZ";
    int i, x;

    printf("Enter plaintext: ");
    fgets(s, sizeof(s), stdin);

    for (i = 0; s[i]; i++) {
        if (isalpha((unsigned char)s[i])) {
            x = toupper((unsigned char)s[i]) - 'A';
            char c = key[x];
            s[i] = islower((unsigned char)s[i])
                 ? tolower(c) : c;
        }
    }

    printf("Ciphertext: %s", s);
    return 0;
}
