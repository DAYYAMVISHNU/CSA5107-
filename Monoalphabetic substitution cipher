#include <stdio.h>
#include <ctype.h>

int main() {
    char s[100];
    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i, x;

    printf("Enter text: ");
    fgets(s, sizeof(s), stdin);

    for (i = 0; s[i]; i++) {
        if (isalpha((unsigned char)s[i])) {
            x = toupper((unsigned char)s[i]) - 'A';
            s[i] = islower((unsigned char)s[i])
                 ? tolower(key[x]) : key[x];
        }
    }
    printf("Ciphertext: %s", s);
    return 0;
}
