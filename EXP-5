#include <stdio.h>
#include <ctype.h>

int main() {
    char s[100];
    int a,b,i;

    printf("Enter text: ");
    fgets(s,sizeof(s),stdin);
    printf("Enter a and b: ");
    scanf("%d%d",&a,&b);

    if(a<1 || a>25 || b<0 || b>25) {
        printf("Invalid key\n");
        return 0;
    }
    int x=a;
    while(x%2==0) x/=2;
    while(x%13==0) x/=13;
    if(x!=1) {
        printf("Invalid a: must be coprime to 26\n");
        return 0;
    }

    for(i=0;s[i];i++)
        if(isalpha((unsigned char)s[i])) {
            char base=islower((unsigned char)s[i])?'a':'A';
            s[i]=(a*(s[i]-base)+b)%26+base;
        }

    printf("Ciphertext: %s",s);
    return 0;
}
